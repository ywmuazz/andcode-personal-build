+package com.yugahashimoto.andcode.runtime.local
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+
+/**
+ * Stored threads survive app-server restarts, but loaded threads do not. thread/read and the
+ * UI's local message cache cannot restore them. Resume before sending; resuming an already
+ * loaded thread reuses it. Keep both requests on this exact client: using CodexRuntime.call
+ * twice could silently start a different server between resume and turn/start.
+ *
+ * Do not retry turn/start after a transport failure: it may already have executed the prompt.
+ */
+internal suspend fun CodexJsonRpcClient.startResumedTurn(params: JsonObject): JsonObject {
+    val threadId = requireNotNull(params["threadId"]) { "Missing threadId" }
+    call("thread/resume", buildJsonObject { put("threadId", threadId) })
+    return call("turn/start", params)
+}
